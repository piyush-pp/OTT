# Copy relevant sections into backend/.env, worker/.env, frontend/.env
# Local dev uses Docker Compose for Postgres/Redis/MinIO and an nginx proxy as "CDN".

# ─── Shared ───────────────────────────────────────────────────────────────────
CDN_BASE_URL=http://localhost:8080

# ─── Postgres ─────────────────────────────────────────────────────────────────
# `connection_limit` caps Prisma's pool per process; `pool_timeout` (seconds)
# is how long a query will wait for a free connection before erroring.
# Tune these for your DB capacity — defaults below are safe for local dev.
DATABASE_URL=postgresql://ott:ott@localhost:5432/ott?schema=public&connection_limit=10&pool_timeout=20

# ─── Redis (BullMQ) ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Must be at least 16 characters. Use: openssl rand -hex 32
JWT_SECRET=replace_me_with_a_long_random_string

# ─── MinIO / S3-compatible storage ────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ott
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Leave blank in dev — emails will be printed to the backend console instead.
# For production use any SMTP provider (Resend, Postmark, SendGrid, etc.)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_api_key
# SMTP_FROM=noreply@yourdomain.com

# ─── Upload limits ────────────────────────────────────────────────────────────
# Maximum upload size in bytes (default: 2 GB)
# MAX_UPLOAD_BYTES=2147483648

# ─── Public-facing URL ────────────────────────────────────────────────────────
# Base URL used to construct share links (e.g. http://localhost:4000/s/<token>)
# and embed iframe src (http://localhost:4000/embed/<id>).
PUBLIC_BASE_URL=http://localhost:4000

# ─── Worker ───────────────────────────────────────────────────────────────────
# How many transcode jobs the worker runs concurrently. Default 2.
# WORKER_CONCURRENCY=2

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:4000
