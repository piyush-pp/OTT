# Copy relevant sections into backend/.env, worker/.env, frontend/.env
# Local dev uses Docker Compose for Postgres/Redis/MinIO and an nginx proxy as "CDN".

# Shared
CDN_BASE_URL=http://localhost:8080

# Postgres
DATABASE_URL=postgresql://ott:ott@localhost:5432/ott?schema=public

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=replace_me_with_a_long_random_string

# MinIO / S3-compatible storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ott
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Frontend
VITE_API_BASE_URL=http://localhost:4000
